format novell nlm 'update'
option nodefault
option start=_Prelude
option exit=_Stop
option stack=32768
option version=1.0.0
option copyright 'llm_agent update helper'
option screenname 'None'
file update.obj
module clib
import _StartNLM, _TerminateNLM, _SetupArgv
import ConsolePrintf, ThreadSwitchWithDelay, delay, system
import fopen, fclose, rename, remove, fflush, fread, fwrite, ferror, fseek, ftell
import memcpy, memset, memcmp, strcmp, strcpy, strlen, sprintf
import FindNLMHandle, GetCurrentTicks, access, mkdir, __get_errno_ptr
name UPDATE
