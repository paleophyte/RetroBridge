format novell nlm 'sockping'
option nodefault
option start=_Prelude
option exit=_Stop
option stack=32768
option version=1.0.0
option copyright 'llm_agent netware proof'
option screenname 'None'
file _sockping.obj
file vendor\imports\prelude.obj
module clib
import _StartNLM, _TerminateNLM, _SetupArgv
import ConsolePrintf, ThreadSwitch, ThreadSwitchWithDelay, ioctl
import socket, bind, listen, accept, send, recv, close, setsockopt
import memset, strlen
name SOCKPING
