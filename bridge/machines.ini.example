# One section per legacy machine. Section name is the `machine` argument
# every legacy_* MCP tool takes. Copy this file to machines.ini (gitignored,
# since exec_token is a secret) and fill in your real machines.

[win2k-1]
host = 192.168.56.10
exec_port = 2222
exec_token = REPLACE_WITH_UNIQUE_TOKEN

# exec_port is optional - defaults to 2222.
[winxp-1]
host = 192.168.56.11
exec_token = a-different-long-random-shared-secret
